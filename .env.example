# Configuración de Stark Reactor IoT Monitor
# Copie este archivo a `.env` y sustituya los valores REEMPLAZAR.
# `.env` está excluido de Git: nunca suba claves reales al repositorio.

# --- Canal ThingSpeak (obligatorio) ---
# Identificador numérico del canal público del equipo.
THINGSPEAK_CHANNEL_ID=3566091

# --- Claves de la API (pestaña "API Keys" del canal) ---
# Obligatoria para enviar muestras al canal.
THINGSPEAK_WRITE_API_KEY=REEMPLAZAR
# Opcional: un canal público se puede leer sin clave.
THINGSPEAK_READ_API_KEY=

# --- Ajustes de conexión (opcionales) ---
THINGSPEAK_BASE_URL=https://api.thingspeak.com
# Tiempo máximo de espera de cada petición HTTP, en segundos.
THINGSPEAK_HTTP_TIMEOUT=10
